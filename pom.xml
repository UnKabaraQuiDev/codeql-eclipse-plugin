<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>lu.kbra</groupId>
  <artifactId>codeql-eclipse-parent</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <modules>
    <module>lu.kbra.codeql</module>
    <module>lu.kbra.codeql.feature</module>
    <module>lu.kbra.codeql.repository</module>
  </modules>
  <properties>
    <tycho.version>4.0.13</tycho.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
  </properties>
  <repositories>
    <repository>
      <id>eclipse-2026-09</id>
      <layout>p2</layout>
      <url>https://download.eclipse.org/releases/2026-09/</url>
    </repository>
  </repositories>
  <build>
    <plugins>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-maven-plugin</artifactId>
        <version>${tycho.version}</version>
        <extensions>true</extensions>
      </plugin>
                                        <plugin>
                                                <groupId>com.diffplug.spotless</groupId>
                                                <artifactId>spotless-maven-plugin</artifactId>
                                                <configuration>
                                                        <java>
                                                                <eclipse>
                                                                        <file>
                                                                                https://raw.githubusercontent.com/UnKabaraQuiDev/PCLib/main/eclipse-format.xml
                                                                        </file>
                                                                </eclipse>
                                                                <removeUnusedImports />
                                                                <importOrder>
                                                                        <order>java,javax,org,com,lu</order>
                                                                </importOrder>
                                                                <trimTrailingWhitespace />
                                                                <endWithNewline />
                                                        </java>
                                                </configuration>
                                      </plugin>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>target-platform-configuration</artifactId>
        <version>${tycho.version}</version>
        <configuration>
          <environments>
            <environment>
              <os>linux</os><ws>gtk</ws><arch>x86_64</arch>
            </environment>
          </environments>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
